# ─── Kontaktformular (Resend) ────────────────────────────────────────────
# API-Key aus https://resend.com/api-keys – NUR serverseitig, niemals mit NEXT_PUBLIC_ prefixen.
RESEND_API_KEY=
# Verifizierte Absenderadresse deiner Domain in Resend, z. B. "SCALEEVERYTHING <anfrage@deine-domain.de>"
CONTACT_FROM_EMAIL=
# Postfach, in dem Anfragen landen sollen
CONTACT_TO_EMAIL=

# ─── Öffentliche Seiten-URL (für Metadaten, Sitemap, OG) ─────────────────
NEXT_PUBLIC_SITE_URL=https://www.example.com
